{
  "name": "main-gate",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "test (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "test (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "test (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "packages",
            "integration_id": 15368
          },
          {
            "context": "Secret scanning",
            "integration_id": 15368
          },
          {
            "context": "GitHub Actions audit",
            "integration_id": 15368
          },
          {
            "context": "Dependency vulnerabilities",
            "integration_id": 15368
          },
          {
            "context": "Go security analysis",
            "integration_id": 15368
          },
          {
            "context": "Trivy vulnerability scan",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "squash",
          "rebase"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    }
  ]
}
